{
  "manifest_version": 3,
  "name": "Presence Shield",
  "version": "2.2.0",
  "minimum_chrome_version": "119",
  "description": "Che các kênh hoạt động đã hỗ trợ, fullscreen giả lập và hiển thị trạng thái áp dụng trên website.",
  "permissions": ["storage", "scripting", "tabs", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Presence Shield", "default_popup": "popup/popup.html" },
  "options_page": "popup/popup.html",
  "commands": {
    "collapse-fullscreen": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Thu giao diện fullscreen giả lập, giữ trạng thái ảo"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
